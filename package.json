{
  "name": "foodino",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/run-with-local-supabase.mjs node node_modules/next/dist/bin/next dev",
    "build": "next build",
    "build:local": "node scripts/run-with-local-supabase.mjs node node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase db test --local",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:types:check": "node scripts/generate-database-types.mjs --check",
    "security": "npm audit --audit-level=high",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run build:local"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "framer-motion": "^13.2.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "styled-components": "6.5.3",
    "server-only": "^0.0.1",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "knip": "6.35.1",
    "supabase": "2.117.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
